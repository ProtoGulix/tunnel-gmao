# Environnements et secrets : jamais versionnés
.env
.env.*
!.env.example

# Python
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/

# Outils
graphify-out/
.claude/settings.local.json
.claude/worktrees/

# Sauvegardes et données
*.sql.gz
backup_*.sql
*.log

# Dumps de migration v4 : données réelles, jamais versionnées
deploy/backups-v4/

# Bascule automatique : paramètres du serveur et archives (dumps, secrets), jamais versionnés
deploy/bascule.conf
deploy/archives-bascule/

# Archives et données locales, jamais versionnées
private/

# Guide utilisateur (VitePress) : dépendances, sortie de construction et cache
docs/site/node_modules/
docs/site/.vitepress/dist/
docs/site/.vitepress/cache/

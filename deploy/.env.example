# Tunnel GMAO : configuration de l'installation.
# Ne pas copier ce fichier à la main : deploy/install.sh crée deploy/.env avec des
# secrets aléatoires. Ce fichier ne contient jamais de secret et reste versionné.
# deploy/.env n'est jamais versionné et ne doit jamais être partagé.

# --- Secrets (générés par install.sh) -----------------------------------------
# Mot de passe du rôle PostgreSQL propriétaire (migrations). Lettres et chiffres.
DB_OWNER_PASSWORD=
# Mot de passe du rôle applicatif sans superuser (créé au premier démarrage).
DB_APP_PASSWORD=
# Clé de signature des jetons de connexion, 64 caractères. La changer déconnecte
# tout le monde.
JWT_SECRET_KEY=

# --- Premier administrateur ---------------------------------------------------
# Compte créé au premier démarrage. Son mot de passe est affiché une seule fois :
#   docker compose logs api
ADMIN_EMAIL=

# --- Accès réseau -------------------------------------------------------------
# Adresse d'écoute du port publié. 127.0.0.1 : seulement cette machine (à utiliser
# derrière un proxy HTTPS installé sur la même machine). 0.0.0.0 : tout le réseau
# (réseau interne de confiance uniquement, jamais directement sur Internet).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Adresse publique telle que tapée dans le navigateur (sert aux QR codes imprimés).
PUBLIC_URL=http://localhost:8080

# --- IP réelle des clients derrière un proxy ----------------------------------
# L'API trace l'IP de chaque connexion. Par défaut, c'est l'adresse TCP vue par
# nginx. Derrière un proxy externe (Cloudflare, Traefik, Caddy...), toutes les
# connexions viendraient du proxy : indiquer ici ses adresses (CIDR séparés par
# des espaces) et l'en-tête qui porte l'IP du client. L'en-tête n'est cru que
# si la connexion vient d'une de ces adresses.
#   Proxy sur la même machine, via le port publié : TRUSTED_PROXIES=172.16.0.0/12
#   Cloudflare : CF-Connecting-IP, plus les plages de https://www.cloudflare.com/ips/
#   Traefik, Caddy, nginx : X-Forwarded-For
TRUSTED_PROXIES=
REAL_IP_HEADER=X-Forwarded-For

# --- Divers -------------------------------------------------------------------
# Taille maximale d'un envoi (import CSV, pièces jointes).
CLIENT_MAX_BODY_SIZE=20m
# Nombre de processus de l'API.
UVICORN_WORKERS=2

# --- Envoi de mails (facultatif) ----------------------------------------------
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tunnel@example.com
SMTP_FROM_NAME=Tunnel GMAO
SMTP_STARTTLS=true

# Configuration nginx de la stack de dev (ADR 0010), rendue par envsubst au démarrage.
# Fronts servis par les serveurs Vite (rechargement à chaud par websocket), API comme
# en production. Pas de CSP : Vite injecte des scripts en ligne qu'elle bloquerait.
# Pas de blocage des chemins en /. : Vite sert ses dépendances sous /node_modules/.vite/
# et refuse lui-même les fichiers .env (server.fs.deny).
# Ne sert jamais à une installation PME : la production utilise tunnel.conf.template.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 8080;
    server_name _;

    server_tokens off;
    absolute_redirect off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    include /etc/nginx/real_ip.conf;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    # Noms résolus à chaque requête : recréer un conteneur ne laisse pas nginx sur
    # une ancienne adresse.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API : /api/xxx devient /xxx côté FastAPI, comme en production.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Front mobile : Vite sert déjà sous /m/ (VITE_BASE_PATH).
    location = /m {
        return 301 /m/;
    }
    location /m/ {
        set $mobile_upstream ${MOBILE_UPSTREAM};
        proxy_pass $mobile_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_read_timeout 1h;
    }

    # Front web.
    location / {
        set $web_upstream ${WEB_UPSTREAM};
        proxy_pass $web_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_read_timeout 1h;
    }
}

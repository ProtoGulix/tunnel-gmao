# Configuration nginx de Tunnel, rendue par envsubst au démarrage du conteneur
# (templates de l'image officielle). Seules les variables d'environnement
# définies (API_UPSTREAM, DNS_RESOLVER, CLIENT_MAX_BODY_SIZE) sont substituées.
# HTTP uniquement : le HTTPS est assuré par un proxy externe (ADR 0006).

server {
    listen 8080;
    server_name _;

    server_tokens off;
    absolute_redirect off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # IP réelle du client (voir 15-real-ip.sh). Vide par défaut.
    include /etc/nginx/real_ip.conf;

    root /usr/share/nginx/html;
    index index.html;

    # En-têtes de sécurité. Pas d'add_header dans les location : ils masqueraient ceux-ci.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # La caméra sert au scan de QR codes du mobile.
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;

    # Sonde du conteneur (ne passe pas par l'API).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API : /api/xxx devient /xxx côté FastAPI. Le nom est résolu à chaque requête
    # (resolver Docker) : recréer le conteneur api ne laisse pas nginx sur une
    # ancienne adresse.
    location /api/ {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $api_upstream ${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        # Posé par nginx, jamais relayé depuis le client : $remote_addr est l'IP
        # réelle (après real_ip) et remplace tout X-Forwarded-For entrant.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Fichiers à ne jamais garder en cache : une mise à jour doit être vue de suite.
    location ~ ^(/m)?/(index\.html|sw\.js|registerSW\.js|workbox-[^/]+\.js)$ {
        expires -1;
    }
    # Types absents de mime.types.
    location ~ ^(/m)?/manifest\.webmanifest$ {
        default_type application/manifest+json;
        expires -1;
    }
    location = /CHANGELOG.md {
        default_type "text/plain; charset=utf-8";
        expires -1;
    }

    # Ressources à empreinte : cache longue durée, 404 franc si absentes.
    location ~ ^(/m)?/assets/ {
        try_files $uri =404;
        expires 1y;
    }

    # Front mobile sous /m/, repli SPA.
    location = /m {
        return 301 /m/;
    }
    location /m/ {
        try_files $uri /m/index.html;
    }

    # Front web sous /, repli SPA.
    location / {
        try_files $uri /index.html;
    }

    location ~ /\. {
        deny all;
    }
}

# Instance de démonstration Tunnel (ADR 0036). Copier en deploy/demo/.env.demo (jamais
# versionné, droits 600) et remplir les valeurs vides : voir deploy/demo/README.md.
# Ce fichier-ci ne contient aucun secret.

# --- Garde-fous : ne pas changer ----------------------------------------------
# Verrouille mots de passe, comptes et sécurité, coupe les courriels (ADR 0036).
DEMO_MODE=true
MAIL_ENABLED=false
API_ENV=production
# Génère le préventif chaque jour (le chargeur a posé des échéances à rattraper).
SCHEDULED_JOBS_ENABLED=true
SCHEDULED_JOBS_HOUR=5

# --- Base ----------------------------------------------------------------------
# Le nom DOIT contenir « demo » : le chargeur et reset-demo.sh refusent sinon.
DEMO_DB_NAME=tunnel_demo
# Secrets propres à la démonstration (lettres et chiffres), à générer.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
JWT_SECRET_KEY=
# Compte ADMIN de l'installation : son mot de passe aléatoire reste dans les journaux de
# l'API (jamais publié). Adresse à une adresse valide, hors des trois comptes publics.
ADMIN_EMAIL=
# Mot de passe commun des trois comptes publics (technicien@, acheteur@, direction@
# demo.frezille.fr) : 8 caractères au moins, une majuscule, un chiffre.
DEMO_PASSWORD=

# --- Réseau --------------------------------------------------------------------
# Seul le proxy web est publié, sur la machine locale (le tunnel HTTPS s'y raccorde).
HTTP_BIND=127.0.0.1
HTTP_PORT=8090
PUBLIC_URL=http://localhost:8090
TRUSTED_PROXIES=
REAL_IP_HEADER=X-Forwarded-For

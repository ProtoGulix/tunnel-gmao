  "plans": [
    {
      "code": "PRE-PRESSE-TRIM",
      "label": "Entretien trimestriel des presses à injecter",
      "classe": "PRESSE",
      "periodicity_days": 90,
      "auto_accept": true,
      "steps": [
        {
          "label": "Contrôler le niveau et la température de l'huile hydraulique",
          "optional": false
        },
        {
          "label": "Vérifier l'absence de fuite sur flexibles et raccords",
          "optional": false
        },
        {
          "label": "Contrôler le serrage des colliers de chauffe et les thermocouples",
          "optional": false
        },
        {
          "label": "Graisser les colonnes et le mécanisme de fermeture",
          "optional": false
        },
        {
          "label": "Nettoyer les filtres des échangeurs d'eau",
          "optional": true
        }
      ]
    },
    {
      "code": "PRE-CONVOY-QUAD",
      "label": "Contrôle quadrimestriel des convoyeurs",
      "classe": "CONVOY",
      "periodicity_days": 120,
      "auto_accept": false,
      "steps": [
        {
          "label": "Contrôler la tension et l'alignement de la bande",
          "optional": false
        },
        {
          "label": "Graisser les roulements de rouleaux",
          "optional": false
        },
        {
          "label": "Vérifier l'état des protecteurs et des arrêts d'urgence",
          "optional": false
        },
        {
          "label": "Contrôler le motoréducteur (bruit, température, niveau d'huile)",
          "optional": false
        }
      ]
    },
    {
      "code": "PRE-USINAGE-TRIM",
      "label": "Entretien trimestriel des centres d'usinage",
      "classe": "USINAGE",
      "periodicity_days": 90,
      "auto_accept": false,
      "steps": [
        {
          "label": "Vidanger et nettoyer le bac de liquide de coupe, vérifier la concentration",
          "optional": false
        },
        {
          "label": "Contrôler le niveau et la pression du circuit de graissage",
          "optional": false
        },
        {
          "label": "Nettoyer les filtres de l'armoire électrique",
          "optional": false
        },
        {
          "label": "Vérifier le serrage du cône de broche et l'état du tirant",
          "optional": false
        },
        {
          "label": "Contrôler les butées et les protections télescopiques",
          "optional": true
        }
      ]
    },
    {
      "code": "PRE-UTILITE-SEM",
      "label": "Entretien semestriel des compresseurs et sécheurs",
      "classe": "UTILITE",
      "periodicity_days": 180,
      "auto_accept": false,
      "steps": [
        {
          "label": "Remplacer le filtre à air et le filtre à huile",
          "optional": false
        },
        {
          "label": "Contrôler la courroie ou l'accouplement",
          "optional": false
        },
        {
          "label": "Purger les condenseurs et vérifier les purgeurs",
          "optional": false
        },
        {
          "label": "Relever la température de refoulement et la pression de service",
          "optional": false
        },
        {
          "label": "Contrôler les soupapes de sécurité",
          "optional": true
        }
      ]
    },
    {
      "code": "PRE-ROBOT-SEM",
